+int ggml_sycl_can_fuse_hc_norm(const ggml_cgraph * cgraph, int node_idx) {
+    static const int mode = [] { const char * e = getenv("GGML_SYCL_FUSE_HC"); return e ? atoi(e) : 0; }();
+    if (mode == 0 || !g_ggml_sycl_enable_fusion) {
+        return 0;
+    }
+    bool two_pass = false;
+    const char * why = hc_norm_decline(cgraph, node_idx, &two_pass);
+    if (mode == 3 && !why) {
+        two_pass = true;   // test hook: test-backend-ops never aliases, so force pass 2
+    }
+    if (mode == 4 && two_pass) {
+        why = "two pass disabled (mode 4)";   // A/B hook: the one-pass-only behaviour
+    }
+    if (mode >= 2) {
+        // histogram by outcome (one pass / two pass / each decline reason), printed at
+        // power-of-two totals so a partial decline rate is attributable over a prefill
+        static const char * names[16] = { "one pass", "two pass" };
+        static uint64_t     counts[16] = {};
+        static int          n_names = 2;
+        static uint64_t     n = 0;
+        const char * key = why ? why : two_pass ? names[1] : names[0];
+        int k = 0;
+        while (k < n_names && strcmp(names[k], key) != 0) k++;
+        if (k == n_names && n_names < 16) names[n_names++] = key;
+        if (k < 16) counts[k]++;
+        n++;
+        if ((n & (n - 1)) == 0) {
+            std::string s;
+            for (int j = 0; j < n_names; j++) {
+                s += std::string(j ? ", " : "") + names[j] + "=" + std::to_string(counts[j]);
+            }
+            GGML_LOG_INFO("%s: after %llu: %s\n", __func__, (unsigned long long) n, s.c_str());
+        }
+    }
+    return why ? 0 : two_pass ? 2 : 1;
+}
