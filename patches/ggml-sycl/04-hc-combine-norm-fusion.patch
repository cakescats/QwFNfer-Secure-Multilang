+// OUT_PROD -> ADD -> RMS_NORM -> MUL in one pass: the qwfn hyper-connection combine
+// followed by the RMS-norm prologue of the next mix. Per row (c, t) of E columns:
+//   R2[e] = R[e] + y[e] * w[c]           (OUT_PROD with inner dim 1 is one product)
+//   Xn[e] = R2[e] * rsqrt(mean(R2^2) + eps) * gamma[e]
+// R2 is written because it lives on as the residual; the OUT_PROD and RMS_NORM results
+// are never materialised. Each work-item re-reads in the second loop only the R2
+// elements it wrote itself in the first, so no barrier is needed for R2.
+// Eligibility and aliasing: ggml_sycl_can_fuse_hc_norm() in fusion.cpp.
+static void hc_norm_f32(const float * R, const float * y, const float * w, const float * gamma,
+                        float * R2, float * Xn, const int ncols,
+                        const int64_t r_s1, const int64_t r_s2, const int64_t y_s2,
+                        const int64_t w_s0, const int64_t w_s2,
+                        const int64_t r2_s1, const int64_t r2_s2, const int64_t x_s1, const int64_t x_s2,
+                        const int64_t g_s1, const int g_nrows, const float eps,
+                        const sycl::nd_item<3> & item_ct1, float * s_sum, int block_size,
+                        float * scale_out) {
+    const int t   = item_ct1.get_group(1);
+    const int c   = item_ct1.get_group(2);
+    const int tid = item_ct1.get_local_id(2);
+    const int nwarps = block_size / WARP_SIZE;
+
+    const float   wct = w[c * w_s0 + t * w_s2];
+    const float * Rr  = R  + c * r_s1  + t * r_s2;
+    const float * yr  = y  + t * y_s2;
+    float *       R2r = R2 + c * r2_s1 + t * r2_s2;
+    float *       Xr  = Xn + c * x_s1  + t * x_s2;
+    const float * gr  = gamma + (int64_t) (c % g_nrows) * g_s1;
+
+    float tmp = 0.0f;
+    for (int col = tid; col < ncols; col += block_size) {
+        const float p = yr[col] * wct;
+        const float r = Rr[col] + p;
+        R2r[col] = r;
+        tmp += r * r;
+    }
+
+    // same reduction as rms_norm_f32
+    tmp = warp_reduce_sum(tmp, item_ct1);
+    if (block_size > WARP_SIZE) {
+        const auto sub_group = item_ct1.get_sub_group();
+        const auto sg_id = sub_group.get_group_linear_id();
+        const auto wi_in_sg = sub_group.get_local_linear_id();
+        if (wi_in_sg == 0) {
+            s_sum[sg_id] = tmp;
+        }
+        item_ct1.barrier(sycl::access::fence_space::local_space);
+        const size_t nreduce = ceil_div(nwarps, WARP_SIZE);
+        tmp = 0.f;
+        for (size_t i = 0; i < nreduce; i += 1) {
+            tmp += s_sum[wi_in_sg + i * WARP_SIZE];
+        }
+        tmp = warp_reduce_sum(tmp, item_ct1);
+    }
+
+    const float mean  = tmp / ncols;
+    const float scale = sycl::rsqrt(mean + eps);
+    if (scale_out) {   // two-pass: Xn is written by hc_norm_apply_f32 once every row is done
+        if (tid == 0) {
+            scale_out[(int64_t) t * item_ct1.get_group_range(2) + c] = scale;
+        }
+        return;
+    }
+    for (int col = tid; col < ncols; col += block_size) {
+        Xr[col] = scale * R2r[col] * gr[col];
+    }
+}
+
+// Pass 2 of the two-pass form: Xn = R2 * scale[c, t] * gamma, same formula as pass 1's tail.
+static void hc_norm_apply_f32(const float * R2, const float * scale, const float * gamma, float * Xn,
+                              const int ncols, const int nrows,
+                              const int64_t r2_s1, const int64_t r2_s2, const int64_t x_s1, const int64_t x_s2,
+                              const int64_t g_s1, const int g_nrows, const sycl::nd_item<3> & item_ct1) {
+    const int t = item_ct1.get_group(1);
+    const int c = item_ct1.get_group(2);
+    const float s = scale[(int64_t) t * nrows + c];
+    const float * R2r = R2 + c * r2_s1 + t * r2_s2;
+    float *       Xr  = Xn + c * x_s1 + t * x_s2;
+    const float * gr  = gamma + (int64_t) (c % g_nrows) * g_s1;
+    for (int col = item_ct1.get_local_id(2); col < ncols; col += item_ct1.get_local_range(2)) {
+        Xr[col] = s * R2r[col] * gr[col];
+    }
+}
