+void ggml_sycl_op_hc_combine_norm(ggml_backend_sycl_context & ctx, ggml_tensor * out_prod, ggml_tensor * add,
+                                  ggml_tensor * rms_norm, ggml_tensor * mul, bool two_pass) {
+    const ggml_tensor * y = out_prod->src[0];
+    const ggml_tensor * w = out_prod->src[1];
+    const ggml_tensor * R = add->src[0] == out_prod ? add->src[1] : add->src[0];
+    const ggml_tensor * g = mul->src[0] == rms_norm ? mul->src[1] : mul->src[0];
+    float eps = 0.0f;
+    memcpy(&eps, rms_norm->op_params, sizeof(float));
+    GGML_ASSERT(eps >= 0.0f);
+
+    const int     ncols = (int) add->ne[0];
+    const int     nrows = (int) add->ne[1];   // streams (c)
+    const int     nchan = (int) add->ne[2];   // tokens (t)
+    const size_t  f = sizeof(float);
+    const float * R_dd = (const float *) R->data;
+    const float * y_dd = (const float *) y->data;
+    const float * w_dd = (const float *) w->data;
+    const float * g_dd = (const float *) g->data;
+    float *       R2_dd = (float *) add->data;
+    float *       X_dd  = (float *) mul->data;
+    const int64_t r_s1 = R->nb[1] / f, r_s2 = R->nb[2] / f, y_s2 = y->nb[2] / f;
+    const int64_t w_s0 = w->nb[0] / f, w_s2 = w->nb[2] / f;
+    const int64_t r2_s1 = add->nb[1] / f, r2_s2 = add->nb[2] / f;
+    const int64_t x_s1 = mul->nb[1] / f, x_s2 = mul->nb[2] / f;
+    const int64_t g_s1 = g->nb[1] / f;
+    const int     g_nrows = (int) g->ne[1];
+
+    dpct::queue_ptr stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+    const sycl::range<3> global_dims(1, nchan, nrows);
+    ggml_sycl_pool_alloc<float> scale_buf(ctx.pool());
+    float * sc = two_pass ? scale_buf.alloc((size_t) nrows * nchan) : nullptr;
+    if (ncols < 1024) {
+        const sycl::range<3> block_dims(1, 1, WARP_SIZE);
+        stream->submit([&](sycl::handler & cgh) {
+            cgh.parallel_for(sycl::nd_range<3>(global_dims * block_dims, block_dims),
+                [=](sycl::nd_item<3> item_ct1) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                    hc_norm_f32(R_dd, y_dd, w_dd, g_dd, R2_dd, X_dd, ncols, r_s1, r_s2, y_s2, w_s0, w_s2,
+                                r2_s1, r2_s2, x_s1, x_s2, g_s1, g_nrows, eps, item_ct1, nullptr, WARP_SIZE, sc);
+                });
+        });
+    } else {
+        const int work_group_size = ggml_sycl_info().max_work_group_sizes[ctx.device];
+        assert(work_group_size % (WARP_SIZE * WARP_SIZE) == 0);
+        const sycl::range<3> block_dims(1, 1, work_group_size);
+        stream->submit([&](sycl::handler & cgh) {
+            sycl::local_accessor<float, 1> s_sum_acc_ct1(sycl::range<1>(work_group_size / WARP_SIZE), cgh);
+            cgh.parallel_for(sycl::nd_range<3>(global_dims * block_dims, block_dims),
+                [=](sycl::nd_item<3> item_ct1) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                    hc_norm_f32(R_dd, y_dd, w_dd, g_dd, R2_dd, X_dd, ncols, r_s1, r_s2, y_s2, w_s0, w_s2,
+                                r2_s1, r2_s2, x_s1, x_s2, g_s1, g_nrows, eps, item_ct1,
+                                get_pointer(s_sum_acc_ct1), work_group_size, sc);
