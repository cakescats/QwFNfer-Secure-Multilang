+static bool hc_ranges_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    const char * a0 = (const char *) a->data;
+    const char * b0 = (const char *) b->data;
+    return a0 < b0 + ggml_nbytes(b) && b0 < a0 + ggml_nbytes(a);
+}
+
+// Each check is stated in terms of what hc_norm_f32 (norm.cpp) assumes. Returns null if
+// fusable, else a reason (printed with GGML_SYCL_FUSE_HC=2).
+static const char * hc_norm_decline(const ggml_cgraph * cgraph, int i, bool * two_pass) {
+    *two_pass = false;
+    if (i + 4 > cgraph->n_nodes) return "graph end";
+    const ggml_op ops[4]  = { GGML_OP_OUT_PROD, GGML_OP_ADD, GGML_OP_RMS_NORM, GGML_OP_MUL };
+    const int     outs[2] = { i + 1, i + 3 };   // R2 lives on as the residual; Xn is the result
+    if (!ggml_can_fuse_subgraph(cgraph, i, 4, ops, outs, 2)) return "not the op sequence, or an intermediate escapes";
+
+    const ggml_tensor * op  = cgraph->nodes[i];
+    const ggml_tensor * add = cgraph->nodes[i + 1];
+    const ggml_tensor * rn  = cgraph->nodes[i + 2];
+    const ggml_tensor * mul = cgraph->nodes[i + 3];
+    const ggml_tensor * y   = op->src[0];
+    const ggml_tensor * w   = op->src[1];
+
+    // the subgraph test checks uses, not wiring: the chain must actually be connected
+    const ggml_tensor * R = add->src[0] == op ? add->src[1] : add->src[1] == op ? add->src[0] : nullptr;
+    const ggml_tensor * g = mul->src[0] == rn ? mul->src[1] : mul->src[1] == rn ? mul->src[0] : nullptr;
+    if (!R || R == op || rn->src[0] != add || !g || g == rn) return "chain not connected";
+
+    for (const ggml_tensor * t : { y, w, op, R, add, rn, g, mul }) {
+        if (t->type != GGML_TYPE_F32) return "not F32";
+        if (t->ne[3] != 1) return "4-D";
+    }
+    // Prefill only. At decode sizes (T=1: 4 rows, 40 KB) there is nothing to save and the
+    // fused kernel runs just H work-groups; keeping decode on its old path by construction.
+    if (cgraph->nodes[i + 1]->ne[2] < 32) return "decode-sized (T < 32)";
+    // OUT_PROD inner dimension 1: one product per element, y[e,t] * w[c,t]
+    if (y->ne[1] != 1 || w->ne[1] != 1) return "out_prod inner dim != 1";
+    if (op->ne[0] != y->ne[0] || op->ne[1] != w->ne[0] || op->ne[2] != y->ne[2] || w->ne[2] != y->ne[2]) return "out_prod shape";
+    // R, R2, Xn share one [E, H, T] shape; the kernel indexes them by (c, t) row strides
+    if (!ggml_are_same_shape(R, add) || !ggml_are_same_shape(op, add) || !ggml_are_same_shape(mul, add)) return "shape";
+    // gamma is indexed gamma[(c % rows) * s1 + e]: spans E, broadcasts over streams only
+    if (g->ne[0] != add->ne[0] || g->ne[2] != 1 || add->ne[1] % g->ne[1] != 0) return "gamma broadcast";
+    // columns are walked with unit stride in every operand
+    for (const ggml_tensor * t : { y, R, (const ggml_tensor *) add, g, (const ggml_tensor *) mul }) {
+        if (t->nb[0] != sizeof(float)) return "column stride";
+    }
+    // Aliasing. gallocr may place R2 over y or w (dead after the OUT_PROD) and Xn over
+    // R, y, w (dead after the ADD); the fused kernel still reads them, and rows owned by
+    // other work-groups could be overwritten first. Only R2 == R exactly is safe (the ADD
+    // in place): each element is read before it is written, by the same work-item.
+    const bool r2_inplace = add->data == R->data && add->nb[1] == R->nb[1] && add->nb[2] == R->nb[2];
+    if (hc_ranges_overlap(add, R) && !r2_inplace) return "R2 partially overlaps R";
+    for (const ggml_tensor * t : { y, w, g }) {
+        if (hc_ranges_overlap(add, t)) return "R2 overlaps an input";
+    }
+    // Xn exactly over R is the likely placement when R dies at the ADD (the norm output,
+    // which the MUL writes in place, is R-sized), and it is safe: a row's R reads all
+    // complete before the reduction (barrier or sub-group collective) and its Xn writes
+    // come after. R2 == R as well would make Xn == R2, which the loop below rejects.
+    // Xn over R2 or gamma cannot be serviced at all: both are read while Xn is written.
+    if (hc_ranges_overlap(mul, add)) return "Xn overlaps R2";
+    if (hc_ranges_overlap(mul, g))   return "Xn overlaps gamma";
+    // Xn over R (other than exactly), y or w is unsafe in one pass but safe in two: R, y
+    // and w are dead once pass 1 has written R2, and the queue is in order.
+    const bool xn_over_r = mul->data == R->data && mul->nb[1] == R->nb[1] && mul->nb[2] == R->nb[2];
+    if ((hc_ranges_overlap(mul, R) && !xn_over_r) || hc_ranges_overlap(mul, y) || hc_ranges_overlap(mul, w)) {
+        *two_pass = true;
+    }
+    return nullptr;
+}
