+// The hyper-connection stream mean (GGML_SYCL_FUSE_HC_MIX): out[e + t*E] = sum_c m[c] * (sigmoid(u) * xn)[e, c, t]
+// for u, xn [E*H, T] (row strides su, sx), m [H]. The element as unary_mul computes it, the sum in smallk's order.
+void ggml_sycl_hc_mix_mean(dpct::queue_ptr stream, const float * u, const float * xn, const float * m, float * out,
+                           int64_t E, int64_t H, int64_t T, int64_t su, int64_t sx) {
+    const int64_t n = E * T, wg = 256;
+    stream->parallel_for(sycl::nd_range<1>(sycl::range<1>(((n + wg - 1) / wg) * wg), sycl::range<1>(wg)),
+        [=](sycl::nd_item<1> it) {
+            const int64_t i = it.get_global_id(0);
+            if (i >= n) return;
+            const int64_t e = i % E, t = i / E;
+            float acc = 0.0f;
+            for (int64_t c = 0; c < H; c++) {
+                const float uv = u[t * su + c * E + e];
+                const float g  = (1.0f / (1.0f + sycl::exp(-uv))) * xn[t * sx + c * E + e];
+                acc += m[c] * g;
+            }
+            out[i] = acc;
+        });
+}
