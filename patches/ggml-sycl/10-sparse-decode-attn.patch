index 0000000..1d6a762
--- /dev/null
+++ b/ggml/src/ggml-sycl/sdattn.hpp
@@ -0,0 +1,8 @@
+#pragma once
+#include "common.hpp"
+
+// Fused sparse decode attention (GGML_SYCL_FUSE_SPARSE_DECODE=1): the K/V gathers from the q8_0 cache, their
+// F16 casts and the one-token FLASH_ATTN_EXT, as one kernel plus a merge. Returns false when the nodes at i do
+// not match exactly; the caller then runs them as usual. On true the caller skips the 8 nodes after i.
+bool ggml_sycl_fuse_sparse_decode_enabled();
+bool ggml_sycl_sparse_decode_attn_fused(ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int i);
