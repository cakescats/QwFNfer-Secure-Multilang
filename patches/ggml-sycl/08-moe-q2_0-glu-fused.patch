+// ---- fused gate + up + SwiGLU, q2_0 MoE, one token (see apply_moeglu.py) ----
+static __dpct_inline__ float q2_0_block_dot(const block_q2_0 * bx, const block_q8_1 * y0) {
+    const uint16_t * q16 = (const uint16_t *) bx->qs;
+    uint32_t w[4];
+#pragma unroll
+    for (int k = 0; k < 4; k++) w[k] = (uint32_t) q16[2 * k] | ((uint32_t) q16[2 * k + 1] << 16);
+    const block_q8_1 * y1 = y0 + 1;
+    const int * u0 = (const int *) y0->qs;
+    const int * u1 = (const int *) y1->qs;
+    int s0 = 0, s1 = 0;
+#pragma unroll
+    for (int k = 0; k < 8; k++) s0 = dpct::dp4a(q2_0_expand_byte((w[k / 4] >> (8 * (k % 4))) & 0xFFu), u0[k], s0);
+#pragma unroll
+    for (int k = 0; k < 8; k++) s1 = dpct::dp4a(q2_0_expand_byte((w[2 + k / 4] >> (8 * (k % 4))) & 0xFFu), u1[k], s1);
+    const sycl::float2 ds0 = y0->ds.convert<float, sycl::rounding_mode::automatic>();
+    const sycl::float2 ds1 = y1->ds.convert<float, sycl::rounding_mode::automatic>();
+    return (float) bx->d * ((s0 * ds0.x() - ds0.y()) + (s1 * ds1.x() - ds1.y()));
+}
+
+template <int LPR>
+static void mul_mat_vec_q2_0_moe_glu_wide(
+    const void * __restrict__ vx_gate, const void * __restrict__ vx_up, const void * __restrict__ vy,
+    float * __restrict__ dst_base, const int32_t * __restrict__ ids_dev, const int ncols, const int nrows,
+    const size_t stride_gate, const size_t stride_up, const size_t dst_row_stride, const sycl::nd_item<3> & it) {
+    constexpr int ROWS_PER_SG = WARP_SIZE / LPR;
+    const int expert_idx = it.get_group(1);
+    const int i02        = ids_dev[expert_idx];
+    const int lane       = it.get_local_id(2);
+    const int row        = (it.get_group(2) * it.get_local_range(1) + it.get_local_id(1)) * ROWS_PER_SG + lane / LPR;
+    const int t          = lane % LPR;
+    const block_q8_1 * y = (const block_q8_1 *) vy;              // one input, shared by every expert
+    float * dst = (float *) ((char *) dst_base + (size_t) expert_idx * dst_row_stride);
+
+    const int blocks_per_row = ncols / QK2_0;
+    float g = 0.0f, u = 0.0f;
+    if (row < nrows) {
+        const block_q2_0 * xg = (const block_q2_0 *) ((const char *) vx_gate + (size_t) i02 * stride_gate) + (size_t) row * blocks_per_row;
+        const block_q2_0 * xu = (const block_q2_0 *) ((const char *) vx_up   + (size_t) i02 * stride_up)   + (size_t) row * blocks_per_row;
+        for (int b = t; b < blocks_per_row; b += LPR) {
+            g += q2_0_block_dot(xg + b, y + 2 * b);
+            u += q2_0_block_dot(xu + b, y + 2 * b);
+        }
+    }
+#pragma unroll
+    for (int mask = LPR / 2; mask > 0; mask >>= 1) {
+        g += dpct::permute_sub_group_by_xor(it.get_sub_group(), g, mask);
+        u += dpct::permute_sub_group_by_xor(it.get_sub_group(), u, mask);
+    }
+    if (row < nrows && t == 0) {
+        dst[row] = g / (1.0f + sycl::exp(-g)) * u;   // op_silu(g) * u
+    }
+}
