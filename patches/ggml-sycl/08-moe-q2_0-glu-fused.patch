+bool ggml_sycl_moe_q2w_on() { return ggml_sycl_moe_q2w_enabled(); }
+
+void ggml_sycl_mul_mat_vec_q2_0_moe_glu(const void * vx_gate, const void * vx_up, const void * vy, const int32_t * ids_dev,
+                                        float * dst_base, int ncols, int nrows, int n_experts_used,
+                                        size_t stride_gate, size_t stride_up, size_t dst_row_stride, dpct::queue_ptr stream) {
+    const int blocks_per_row = ncols / QK2_0;
+    constexpr int SG_PER_WG = 4;
+    auto go = [&](auto lpr_tag) {
+        constexpr int LPR = decltype(lpr_tag)::value;
+        constexpr int ROWS_PER_SG = WARP_SIZE / LPR;
+        const int n_sg = (nrows + ROWS_PER_SG - 1) / ROWS_PER_SG;
+        const sycl::range<3> block_nums(1, (unsigned) n_experts_used, (unsigned) ((n_sg + SG_PER_WG - 1) / SG_PER_WG));
+        const sycl::range<3> block_dims(1, SG_PER_WG, WARP_SIZE);
+        stream->submit([&](sycl::handler & cgh) {
+            cgh.parallel_for(sycl::nd_range<3>(block_nums * block_dims, block_dims),
+                [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                    mul_mat_vec_q2_0_moe_glu_wide<LPR>(vx_gate, vx_up, vy, dst_base, ids_dev, ncols, nrows,
+                        stride_gate, stride_up, dst_row_stride, item);
+                });
+        });
+    };
+    if (blocks_per_row >= WARP_SIZE) go(std::integral_constant<int, WARP_SIZE>{});
+    else                             go(std::integral_constant<int, WARP_SIZE / 2>{});
+}
