+// GGML_SYCL_Q8W=1: one-token Q8_0 matvec over the reorder layout with a whole block per lane. The reorder layout keeps
+// a block's 32 quants contiguous and 32-byte aligned, so they arrive as two 16-byte loads (the stock kernel above
+// reads them in 2-byte pieces, two lanes per block, and both lanes load the block's scale); the matching q8_1
+// activation block is read the same way; then eight dp4a and one scale product. A row belongs to one sub-group and
+// its lanes take blocks lane, lane + WARP_SIZE, ..., so each sub-group step reads WARP_SIZE consecutive blocks.
+static bool ggml_sycl_q8w_enabled() {
+    static const bool on = [] { const char * e = getenv("GGML_SYCL_Q8W"); return e && atoi(e) != 0; }();
+    return on;
+}
+
+static void reorder_mul_mat_vec_q8_0_q8_1_wide_sycl(const void * vx, const void * vy, float * dst, const int ncols,
+                                                    const int nrows, dpct::queue_ptr stream) {
+    GGML_ASSERT(ncols % QK8_0 == 0);
+    constexpr int sg_per_wg = 8;
+    const int     nb        = ncols / QK8_0;
+    const size_t  d_base    = (size_t) ncols * nrows;   // scales follow all quants: [qs0|...|qsN][d0|...|dN]
+    const int     n_wg      = ceil_div(nrows, sg_per_wg);
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>((size_t) n_wg * sg_per_wg * WARP_SIZE), sycl::range<1>(sg_per_wg * WARP_SIZE)),
+        [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            const sycl::sub_group sg  = it.get_sub_group();
+            const int             row = (int) it.get_group(0) * sg_per_wg + (int) sg.get_group_linear_id();
+            if (row >= nrows) {
+                return;   // the whole sub-group shares the row
+            }
+            const int           lane = sg.get_local_linear_id();
+            const int8_t *      xq   = (const int8_t *) vx + (size_t) row * nb * QK8_0;
+            const ggml_half *   xd   = (const ggml_half *) ((const char *) vx + d_base) + (size_t) row * nb;
+            const int8_t *      yq   = (const int8_t *) vy;
+            const sycl::half2 * yds  = (const sycl::half2 *) ((const char *) vy + ncols);
+            float               sum  = 0.0f;
+#pragma unroll 2
+            for (int i = lane; i < nb; i += WARP_SIZE) {
+                const sycl::int4 * xv = (const sycl::int4 *) (xq + (size_t) i * QK8_0);
+                const sycl::int4 * yv = (const sycl::int4 *) (yq + (size_t) i * QK8_1);
+                const sycl::int4   x0 = xv[0], x1 = xv[1];
+                const sycl::int4   y0 = yv[0], y1 = yv[1];
+                int                s  = 0;
+#pragma unroll
+                for (int j = 0; j < 4; j++) {
+                    s = dpct::dp4a(x0[j], y0[j], s);
+                }
+#pragma unroll
+                for (int j = 0; j < 4; j++) {
+                    s = dpct::dp4a(x1[j], y1[j], s);
+                }
+                sum += static_cast<float>(xd[i]) * static_cast<float>(yds[i][0]) * s;
+            }
+            sum = sycl::reduce_over_group(sg, sum, sycl::plus<float>());
+            if (lane == 0) {
+                dst[row] = sum;
+            }
+        });
 }
 
