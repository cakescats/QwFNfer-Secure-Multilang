+// one-token conv at the CONCAT i: returns the SILU's index, or 0
+static int f3_match_conv(const ggml_cgraph * g, int i, int * i_cpy, int * i_conv) {
+    const ggml_tensor * cat = g->nodes[i];
+    if (cat->op != GGML_OP_CONCAT || cat->op_params[0] != 0 || cat->type != GGML_TYPE_F32) return 0;
+    const ggml_tensor * st = cat->src[0], * xt = cat->src[1];
+    if (st->type != GGML_TYPE_F32 || xt->type != GGML_TYPE_F32 || xt->ne[0] != 1 || st->ne[2] != 1 || xt->ne[2] != 1) return 0;
+    const int64_t hist = st->ne[0], C = st->ne[1];
+    if (hist < 1 || hist > 7 || st->nb[0] != sizeof(float) || cat->ne[0] != hist + 1 || cat->ne[1] != C) return 0;
+    if ((cat->flags & GGML_TENSOR_FLAG_OUTPUT) || ggml_node_get_use_count(g, i) != 2) return 0;
+    int k = i + 1, cpy = -1, conv = -1, silu = -1;
+    for (; k < g->n_nodes && k <= i + 8 && silu < 0; k++) {
+        const ggml_tensor * n = g->nodes[k];
+        if (n->op == GGML_OP_VIEW || n->op == GGML_OP_RESHAPE || n->op == GGML_OP_TRANSPOSE || n->op == GGML_OP_PERMUTE) continue;
+        if (cpy < 0 && n->op == GGML_OP_CPY) { cpy = k; continue; }
+        if (conv < 0 && n->op == GGML_OP_SSM_CONV) { conv = k; continue; }
+        if (conv >= 0 && n->op == GGML_OP_UNARY && ggml_get_unary_op(n) == GGML_UNARY_OP_SILU && n->src[0] == g->nodes[conv]) { silu = k; continue; }
+        return 0;
+    }
+    if (cpy < 0 || conv < 0 || silu < 0) return 0;
+    const ggml_tensor * cp = g->nodes[cpy], * sc = g->nodes[conv], * su = g->nodes[silu];
+    const ggml_tensor * tail = cp->src[0], * sdst = cp->src[1];
+    if (tail->view_src != cat || tail->view_offs != (size_t) 1 * sizeof(float) || tail->ne[0] != hist || tail->ne[1] != C) return 0;
+    if (!f3_f32c(sdst) || ggml_nelements(sdst) != hist * C) return 0;
+    // the old state (st) and the new (sdst): the same memory in the same layout (each work-item reads its own row
+    // before writing it), or disjoint
+    const bool same = sdst->data == st->data && st->nb[1] == (size_t) hist * sizeof(float);
+    if (!same && f3_ranges_overlap(sdst, st)) return 0;
+    if (sc->src[0] != cat || sc->src[1]->type != GGML_TYPE_F32 || !ggml_is_contiguous(sc->src[1]) || sc->src[1]->ne[0] != hist + 1 || sc->src[1]->ne[1] != C) return 0;
+    if (!f3_f32c(su) || su->ne[0] != C || ggml_nelements(su) != C) return 0;
+    if (!f3_single(g, conv) || (cp->flags & GGML_TENSOR_FLAG_OUTPUT)) return 0;
+    for (int j = i + 1; j < silu; j++) if (g->nodes[j] == tail && !f3_single(g, j)) return 0;
+    *i_cpy = cpy; *i_conv = conv;
+    return silu;
+}
+static void f3_conv(dpct::queue_ptr q, const ggml_tensor * cat, const ggml_tensor * cp, const ggml_tensor * sc, ggml_tensor * su) {
+    const ggml_tensor * st = cat->src[0], * xt = cat->src[1];
+    const int64_t hist = st->ne[0], C = st->ne[1];
+    const float * sd = (const float *) st->data; const int64_t s1 = st->nb[1] / 4;
+    const char * xd = (const char *) xt->data; const size_t x1 = xt->nb[1];
+    const float * wd = (const float *) sc->src[1]->data;
+    float * od = (float *) su->data; float * nd = (float *) cp->src[1]->data;
+    q->parallel_for(sycl::nd_range<1>(sycl::range<1>(((C + 255) / 256) * 256), sycl::range<1>(256)), [=](sycl::nd_item<1> it) {
+        const int64_t c = it.get_global_id(0);
+        if (c >= C) return;
+        float p[8];
+        for (int64_t h = 0; h < hist; h++) p[h] = sd[c * s1 + h];
+        p[hist] = *(const float *) (xd + c * x1);
+        float sumf = 0.0f;
+        for (int64_t i0 = 0; i0 <= hist; i0++) sumf += p[i0] * wd[c * (hist + 1) + i0];
+        od[c] = sumf / (1.0f + sycl::exp(-sumf));
+        for (int64_t h = 0; h < hist; h++) nd[c * hist + h] = p[h + 1];
+    });
+}
