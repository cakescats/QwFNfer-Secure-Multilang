+// ---- Q2_0_SOA (see scripts/box/q2soa/apply_q2soa.py) ----
+// A tensor's slices: blocks per 2-D slice, and how many slices. Writes and reads must cover whole slices, and the
+// slices must be packed (the MUL_MAT_ID weights the engine builds, and 1-D transfer handles, are).
+static bool q2_0_soa_geometry(const ggml_tensor * t, size_t offset, size_t size, int64_t & bps, int64_t & nslices) {
+    bps = (t->ne[0] / QK2_0) * t->ne[1];
+    nslices = t->ne[2] * t->ne[3];
+    const size_t slice_bytes = (size_t) bps * sizeof(block_q2_0);
+    if (t->ne[0] % QK2_0 != 0 || t->nb[1] != (size_t) (t->ne[0] / QK2_0) * sizeof(block_q2_0)) return false;
+    if (t->ne[2] > 1 && t->nb[2] != slice_bytes) return false;
+    if (t->ne[3] > 1 && t->nb[3] != slice_bytes * t->ne[2]) return false;
+    return offset == 0 && size == slice_bytes * (size_t) nslices;
+}
+// canonical q2_0 blocks (src) <-> [codes][scales] per slice (dst); one work-item per block
+static void q2_0_to_soa(const uint8_t * src, uint8_t * dst, int64_t bps, int64_t nslices, dpct::queue_ptr q) {
+    const int64_t n = bps * nslices;
+    q->parallel_for(sycl::range<1>((size_t) n), [=](sycl::id<1> id) {
+        const int64_t g = id[0], s = g / bps, j = g % bps;
+        const uint8_t * b = src + g * sizeof(block_q2_0);
+        uint8_t * slice = dst + s * bps * sizeof(block_q2_0);
+        for (int k = 0; k < 16; k++) slice[j * 16 + k] = b[2 + k];
+        slice[bps * 16 + j * 2 + 0] = b[0];
+        slice[bps * 16 + j * 2 + 1] = b[1];
+    });
+}
+static void q2_0_from_soa(const uint8_t * src, uint8_t * dst, int64_t bps, int64_t nslices, dpct::queue_ptr q) {
+    const int64_t n = bps * nslices;
+    q->parallel_for(sycl::range<1>((size_t) n), [=](sycl::id<1> id) {
+        const int64_t g = id[0], s = g / bps, j = g % bps;
+        const uint8_t * slice = src + s * bps * sizeof(block_q2_0);
+        uint8_t * b = dst + g * sizeof(block_q2_0);
+        b[0] = slice[bps * 16 + j * 2 + 0];
+        b[1] = slice[bps * 16 + j * 2 + 1];
+        for (int k = 0; k < 16; k++) b[2 + k] = slice[j * 16 + k];
+    });
+}
