+++ b/ggml/src/ggml-cuda/hc-fuse.cuh
@@ -0,0 +1,20 @@
+#pragma once
+// Hyper-connection fusions for one-token decode graphs (qwfnfer, Qwen3.8-Flash-Next).
+//
+// hc_combine: [SCALE] -> SIGMOID -> SCALE -> RESHAPE -> OUT_PROD -> ADD, i.e.
+//     dst[e, c] = res[e, c] + blk[e] * (s2 * sigmoid(s1 * inj[c] + b1) + b2)
+// hc_gate_t:  SIGMOID -> MUL -> RESHAPE -> PERMUTE(1,0,2,3) -> CONT, i.e.
+//     dst[c, e] = xn[e, c] * sigmoid(u[e, c])   (the transposed gated streams the stream-mean matmul reads)
+//
+// Both reproduce the unfused kernels' arithmetic exactly (same expressions under the same
+// -use_fast_math flags; the product and the sum rounded separately, as two kernels round them),
+// so a graph computes the same bits with or without them. GGML_CUDA_FUSE_HC=0 turns them off.
+#include "common.cuh"
+
+bool ggml_cuda_hc_fuse_enabled();
+
+// Returns the number of nodes after i that the fusion consumed (0: no match).
+int ggml_cuda_try_hc_combine(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i);
+// SCALE -> SILU (the hc mixer's low-rank branch): silu(s * x + b) in one kernel.
+int ggml_cuda_try_scale_silu(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i);
+int ggml_cuda_try_hc_gate_t(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i);
